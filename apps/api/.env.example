# Örnek ortam dosyası — kopyalayıp `cp .env.example .env` sonra doldurun.
# Gerçek `.env` dosyası .gitignore'da; sırları repoya commit'lemeyin.
# (Sürücü DB_DIALECT ile seçilir; varsayılan postgres, geçiş süresince sqlite.)

# ==================== DATABASE ====================
# postgres | sqlite. Varsayılan: postgres (DB_DIALECT boşsa).
# sqlite yalnızca geri dönüş yoludur (DB_DIALECT=sqlite).
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=beauty_salon
# Test veritabanı: `npm test` NODE_ENV=test + `.env.test` ile çalışır ve AYRI bir DB kullanır.
# `.env.test` örneği: DB_DIALECT=postgres, DB_NAME=beauty_salon_test, DB_NAME_TEST=beauty_salon_test
# (test dosyası `.env.*` kuralı gereği commit edilmez). Şema migration'lardan gelir; hazırlık:
#   node tests/helpers/ensure-test-db.js   (DB yoksa oluşturur, migration'ları koşar; DROP DATABASE yapmaz)
DB_NAME_TEST=beauty_salon_test
DB_USER=postgres
DB_PASSWORD=change-me

# ==================== JWT ====================
# En az 32 karakter olmalı; üretimde rastgele üretin:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-min-32-chars
JWT_REFRESH_SECRET=change-me-min-32-chars
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ==================== APP ====================
PORT=3000
NODE_ENV=development
API_PREFIX=/api/v1

# ==================== UPLOAD ====================
UPLOAD_DEST=./uploads
MAX_FILE_SIZE=5242880

# ==================== SEED ====================
# Demo kullanıcıların şifreleri. Yerel geliştirmede boş bırakılabilir
# (seed kendi geliştirme varsayılanlarını kullanır ve konsola yazar).
# NODE_ENV=production'da ÜÇÜ DE ZORUNLUDUR; verilmezse seed çalışmayı reddeder.
SEED_ADMIN_PASSWORD=
SEED_SALON_PASSWORD=
SEED_CUSTOMER_PASSWORD=

# ==================== SMTP ====================
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@beautysalon.com

# ==================== RATE LIMIT ====================
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=100
