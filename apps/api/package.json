{
  "name": "beauty-salon-api",
  "version": "1.0.0",
  "description": "Beauty Salon Platform REST API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node -e \"require('dotenv').config(); require('./src/config/database').connectDB().then(() => require('./src/seeders/seed')())\"",
    "test": "node --env-file=.env.test ./node_modules/mocha/bin/mocha \"tests/**/*.test.js\" --timeout 10000 --exit",
    "test:watch": "node --env-file=.env.test ./node_modules/mocha/bin/mocha \"tests/**/*.test.js\" --watch",
    "test:coverage": "NODE_ENV=test nyc mocha 'tests/**/*.test.js' --timeout 10000 --exit",
    "migrate": "sequelize-cli db:migrate",
    "migrate:undo": "sequelize-cli db:migrate:undo",
    "migrate:undo:all": "sequelize-cli db:migrate:undo:all",
    "migrate:status": "sequelize-cli db:migrate:status"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.3.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "nodemailer": "^8.0.2",
    "pg": "^8.18.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.7",
    "sharp": "^0.34.5",
    "sqlite3": "^5.1.7",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "chai": "^4.3.10",
    "chai-http": "^5.1.2",
    "mocha": "^11.8.0",
    "nodemon": "^3.1.11",
    "sequelize-cli": "^6.6.5",
    "supertest": "^7.2.2"
  }
}
